{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "assets/**,data/*.json,data/*/*.json,scripts/game-dataset-utils.js,*.html,*.js,*.css,*.ico,*.txt,*.xml"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
